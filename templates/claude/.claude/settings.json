{
  "permissions": {
    "deny": [
      "Read(~/.kube/**)",
      "Read(~/.azure/**)",
      "Read(~/.azure-aks-agent/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/aks_guard.py\""
          }
        ]
      }
    ]
  }
}
